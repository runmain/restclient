[
  {
    "label": "▶ Send Request",
    "command": "httpyac-run",
    "args": ["$ZED_FILE", "$ZED_ROW"],
    "tags": ["http-request"],
    "reveal": "always",
    "use_new_terminal": true,
    "save": "all",
    "show_summary": true,
    "show_command": true
  },
  {
    "label": "🌐 Switch Environment",
    "command": "httpyac-run",
    "args": ["$ZED_FILE", "--switch-env"],
    "tags": ["http-request"],
    "reveal": "always",
    "show_summary": true,
    "show_command": true
  },
  {
    "label": "🌐 Send with Environment…",
    "command": "httpyac-run",
    "args": ["$ZED_FILE", "$ZED_ROW", "--pick-env"],
    "tags": ["http-request"],
    "reveal": "always",
    "save": "all",
    "show_summary": true,
    "show_command": true
  }
]
